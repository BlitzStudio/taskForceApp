{
  "expo": {
    "name": "TaskForce",
    "slug": "taskforce",
    "version": "1.0.0",
    "orientation": "portrait",
    //"icon": "./assets/icon.png",
    "scheme": "taskforce",
    "userInterfaceStyle": "automatic",
    
    "splash": {
     // "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.taskforce.app"
    },
    "android": {
      "adaptiveIcon": {
        //"foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.taskforce.app"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
